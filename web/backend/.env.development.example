# Local development only. `npm run dev:db` writes web/backend/.env.development from this (git-ignored).
# A development process (anything that is not Render / NODE_ENV=production) REFUSES any DATABASE_URL that is not this machine.
DATABASE_URL=postgres://strikefit:strikefit@127.0.0.1:54329/strikefit_dev
PORT=4000

# Optional: a hosted dev-only database (for example a Neon branch you created for development) can be allowed by host name:
# DEV_DB_ALLOWED_HOSTS=ep-your-dev-branch-123456.eu-central-1.aws.neon.tech
# Only if you really mean to use a remote database from a laptop (never the production one):
# ALLOW_PROD_DB=1
