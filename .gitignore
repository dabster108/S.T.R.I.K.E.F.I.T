# Unity generated
[Ll]ibrary/
[Ll]ibrary/Bee/
[Ll]ibrary/PackageCache/
[Ll]ibrary/ScriptAssemblies/
[Ll]ibrary/StateCache/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# MemoryCaptures can get excessive in size
[Mm]emoryCaptures/

# Recordings
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you want to ignore the local Unity addressables build cache
# /[Aa]ssets/AddressableAssetsData/*/*.bin*

# Autogenerated Crash Reports / Burst
sysinfo.txt
mono_crash.*.json
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Builds / player
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86_64
app.app/
*.ipa

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Gradle / Android
.gradle/
**/.gradle/
**/ExportedObj/
*.unitypackage

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Meta XR / Oculus local caches (keep Assets/Oculus project config)
# Ignore common generated build caches outside Assets if present
OculusBuildCache/
.oculus/

# Crashlytics / Plastic / Collaborate
crashlytics-build.properties
*.private
*.private.meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated IDE files
InitTestScene*.unity*

# Unity crash-recovery scene backups
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Optional local env / secrets
.env
.env.*

# Backend data now lives in Neon Postgres; the old JSON store and its backup stay local
web/backend/db.json
web/backend/db.json.bak
web/backend/db.json.tmp

# Unity local tooling cache
.utmp/

# Large build / archive outputs
*.obb
*.symbols.zip
*.zip
*.7z
*.rar

# AllSkyFree: only the Space_AnotherPlanet cubemap skybox is used (Level1_Easy)
/[Aa]ssets/AllSkyFree/*
!/[Aa]ssets/AllSkyFree/Space_AnotherPlanet/
!/[Aa]ssets/AllSkyFree/Space_AnotherPlanet.meta
/[Aa]ssets/AllSkyFree/Space_AnotherPlanet/*Equirect*

# Raw downloads / exports outside Assets (the imported copies live under Assets/)
/Ch25_nonPBR.fbx
/Exports/
/armored-executioner-horned-helm-flail/
/free-mace-katana-axe-weapon-pack-sketch-mesh/
/mace-doom-the-dark-ages-rigged/
/war-flail/

# Web stack (Node / React)
web/backend/node_modules/
web/frontend/node_modules/
web/frontend/dist/
npm-debug.log*
